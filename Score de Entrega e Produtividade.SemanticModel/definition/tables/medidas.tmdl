	measure time_lead_pack = ```
			
			
			VAR vSegundos = 
			SUM(packing[duracao_segundos_tote_dia])
			
			VAR vTotal = 
			DIVIDE(
			    vSegundos,
			    COUNT(packing[tote]))
			
			VAR horas = 
			INT(vTotal/3600)
			VAR vmod = 
			MOD(vTotal,3600)
			VAR minutos = 
			INT(vmod/60)
			VAR segundos = 
			MOD(vTotal,60)
			VAR hora_tratada = 
			horas * 10000+
			minutos * 100+
			segundos
			
			RETURN
			hora_tratada
			```
		formatString: 00:00:00
		displayFolder: Time Lead Operacional\Packing
		lineageTag: 66f50b88-f085-4562-a558-76324b703d0d

		annotation PBI_FormatHint = {"isCustom":true}

