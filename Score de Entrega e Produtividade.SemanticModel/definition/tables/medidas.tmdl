	measure bottleneck_box = ```
			
			
			VAR vsegundos = 
			SUM(
			    bottleneck_box[diferenca_segundos])
			
			VAR vTotal = 
			DIVIDE(
			    vsegundos,COUNT(bottleneck_box[olpn]))
			
			VAR horas = 
			INT(vTotal/3600)
			VAR vmod = 
			MOD(vTotal,3600)
			VAR minutos = 
			INT(vmod/60)
			VAR segundos = 
			MOD(vTotal,60)
			VAR hora_tratada = 
			horas * 10000+
			minutos * 100+
			segundos
			
			RETURN
			hora_tratada
			```
		formatString: 00:00:00
		displayFolder: Time Lead Operacional\Bottleneck Box
		lineageTag: eb34d4ad-6aa2-4108-8321-336fc0dc96de

		annotation PBI_FormatHint = {"isCustom":true}

