	measure subtitulo_din = ```
			
			
			VAR vPeriodo = 
			FORMAT(MAX(d_calendario[Data Sem Domingo]), "mmm/yyyy")
			
			VAR vTotal_vendas = 
			[qt_movimentada_din_user]
			
			VAR vol = 
			SUM(olpn[volume])
			
			VAR vVol =
			    SWITCH(
			        TRUE(),
			        vTotal_vendas >= 1000, FORMAT(vol, "#,0,.000.0 m³"),
			        FORMAT(vol, "# m³"))
			
			VAR vTotal_vendas_formatada = 
			    SWITCH(
			        TRUE(),
			        vTotal_vendas >= 1000000000, FORMAT(vTotal_vendas, "#,0,,,.00 bi"),
			        vTotal_vendas >= 1000000, FORMAT(vTotal_vendas, "#,0,,.00 mi"),
			        vTotal_vendas >= 1000, FORMAT(vTotal_vendas, "#,0,.00 k"),
			        FORMAT(vTotal_vendas, "#"))
			
			RETURN
			
			"Total expedido em "&" "&vPeriodo&" foi "&vTotal_vendas_formatada&" | Com o volume mº de "&vVol
			```
		displayFolder: Calendário Dinâmico
		lineageTag: 5d4bb6e2-781d-42ce-997e-126fde7b3902

	measure calendar_Expedidos_sem = ```
			
			
			VAR vTotal_vendas = 
			[qt_movimentada_din_user]
			
			VAR vTotal_vendas_formatada = 
			    SWITCH(
			        TRUE(),
			        vTotal_vendas >= 1000000000, FORMAT(vTotal_vendas, "#,0,,,.00 bi"),
			        vTotal_vendas >= 1000000, FORMAT(vTotal_vendas, "#,0,,.00 mi"),
			        vTotal_vendas >= 1000, FORMAT(vTotal_vendas, "#,0,.00 k"),
			        FORMAT(vTotal_vendas, "#"))
			
			VAR cond_exp = 
			IF( vTotal_vendas = 0, "-", vTotal_vendas_formatada)
			
			VAR vMedia = 
			[media_olpn_diarizado]
			
			VAR vMedia_formata = 
			    SWITCH(
			        TRUE(),
			        vMedia >= 1000000000, FORMAT(vMedia, "#,0,,,.00 bi"),
			        vMedia >= 1000000, FORMAT(vMedia, "#,0,,.00 mi"),
			        vMedia >= 1000, FORMAT(vMedia, "#,0,.00 k"),
			        FORMAT(vMedia, "#"))
			
			VAR cond_media = 
			IF( vMedia_formata = "", "-", vMedia_formata)
			
			
			RETURN 
			"-"&UNICHAR(10)&
			"Total "&cond_exp
			&UNICHAR(10)&
			"Média "&cond_media
			```
		displayFolder: Calendário Dinâmico
		lineageTag: 1ca0e2b6-49d5-456f-a519-dbbad267657f

	measure saudacao = ```
			
			
			VAR vSaudacao = 
			SWITCH(
			    TRUE(),
			    HOUR(NOW()) >= 6 && HOUR(NOW()) < 12, "Bom dia!",
			    HOUR(NOW()) >= 12 && HOUR(NOW()) < 18, "Boa tarde!",
			    "Boa noite!"
			)
			
			VAR vNome = 
			[usuario]
			
			VAR vRetorno = 
			vSaudacao&" "&vNome
			
