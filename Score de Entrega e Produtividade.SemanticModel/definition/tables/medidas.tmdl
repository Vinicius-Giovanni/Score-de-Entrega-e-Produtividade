	measure entrega_in_full = ```
			
			
			VAR A = 
			CALCULATE(
			    DISTINCTCOUNT(picking[olpn]),
			    picking[qt_separada] < picking[qt_requerida])
			
			VAR B = 
			1 - 
			DIVIDE(
			    A,
			    DISTINCTCOUNT(picking[olpn]))
			
			RETURN
			B
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Análise Prescritiva\OTIF\In-Full
		lineageTag: 8f0fdc9b-dc6c-4380-969f-a39a74b3470f

	measure on_time = ```
			
			
			VAR olpn_on_time = 
			CALCULATE(
			    DISTINCTCOUNT(picking[olpn]),
			    picking[duracao_olpn_segundos] <= INT(SELECTEDVALUE(aux_on_time[segundos])))
			
			VAR total_olpn = 
			DISTINCTCOUNT(picking[olpn])
			
			VAR logica_final = 
			1 - 
			DIVIDE(
			    olpn_on_time,total_olpn,0)
			
			RETURN
			logica_final
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Análise Prescritiva\OTIF\On-Time
		lineageTag: a60cd735-026e-44d5-b4c5-46dec2feb01b

	measure otif = ```
			
			
			VAR olpn_errada = 
			CALCULATE(
			    DISTINCTCOUNT(picking[olpn]),
			    picking[duracao_olpn_segundos] <= INT(SELECTEDVALUE(aux_on_time[segundos])) || picking[qt_separada] < picking[qt_requerida])
			
			VAR total_olpn = 
			DISTINCTCOUNT(picking[olpn])
			
			VAR otif =
			1 - 
			DIVIDE(
			    olpn_errada,total_olpn)
			
			RETURN 
			otif
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Análise Prescritiva\OTIF\OTIF
		lineageTag: db21f2c3-5871-4f47-9f8b-c91b5a6cd5fc

