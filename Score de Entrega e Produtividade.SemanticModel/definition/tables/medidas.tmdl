	measure qt_cancel_mom = ```
			
			
			VAR A = 
			CALCULATE(
			    [qt_cancelada],
			    DATEADD(
			        d_calendario[Data], - 1, MONTH))
			
			VAR B =
			DIVIDE(
			    [qt_cancelada], A) -1
			
			VAR C =
			SWITCH(
			    TRUE(),
			    B >= 0, "🔺"&FORMAT(B,"0.0%"),
			    B = -1, BLANK(),
			    B <= 0, "🔻"&FORMAT(B,"0.0%"))
			
			RETURN
			C
			```
