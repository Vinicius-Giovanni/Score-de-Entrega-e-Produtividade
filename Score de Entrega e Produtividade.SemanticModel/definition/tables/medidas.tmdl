	measure calendario_expedidos = ```
			
			
			VAR vDia = 
			SELECTEDVALUE(d_calendario[Dia])
			
			VAR vTotal_vendas = 
			[qt_movimentada_din_user]
			
			VAR vTotal_vendas_formatada = 
			    SWITCH(
			        TRUE(),
			        vTotal_vendas >= 1000000000, FORMAT(vTotal_vendas, "#,0,,,.00 bi"),
			        vTotal_vendas >= 1000000, FORMAT(vTotal_vendas, "#,0,,.00 mi"),
			        vTotal_vendas >= 1000, FORMAT(vTotal_vendas, "#,0,.00 k"),
			        FORMAT(vTotal_vendas, "#"))
			
			VAR vCap =
			SWITCH(
			    TRUE(),
			    SUM(capacity_1200[Capacity]) < 0, "-",
			    vTotal_vendas = 0 , "-",
			    FORMAT([cap_din_calendar], "0.0%"))
			        
			VAR retorna = 
			vDia& UNICHAR(10)
			&vTotal_vendas_formatada& UNICHAR(10)
			&vCap
			
			RETURN 
			retorna
			```
		displayFolder: Calendário Dinâmico
		lineageTag: eaa6bd3c-bc33-4732-ad57-d92e7b85658d

